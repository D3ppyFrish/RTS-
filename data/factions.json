// Factions. Players get them in this order (player 0, in the west, the first; player 1, in the east, the second;
// and so on) unless the start screen or --factions picks one for them: any faction for any player, the same too.
// experience (optional): the faction's units earn experience and evolve into the forms in units.json
// that evolve from them. levels lists the experience each level needs, in order; at each level a unit
// can take its next form. Units earn perDamage for each hit point of damage they deal to enemy units
// and buildings, perKill for each enemy unit they kill, perBuildSecond for each second of building, and
// perMinute for each minute they stay alive.
// uiLook (optional): how the menus, panels and buttons look while playing the faction: timber (rough
// planks), stone (castle brick) or crystal (dark slate); see game/scripts/UiStyle.cs. Only for looks.
// tamesMonsters (optional): the faction's units beat wild monsters instead of killing them, and the
// player then has each one ridden or recruited (see "lair" and "ride" in units.json). Other factions get
// a lair's reward for clearing it. What each faction makes of a cleared lair's den is the lair's
// "prizes" in units.json.
// duskTree (optional): what the faction's players can do to the map's dusk tree once its warden is gone:
// heal (a unit that heals tends it, grows its canopy and takes up the Dusk Staff) or raze (any of their
// fighting units hack it down, so nobody gets the staff). See "Dusk tree" in docs/rules.md.
// aiStyle (optional): how a computer player plays the faction: waves (the default: it masses its soldiers
// and sends nearly all of them as one big wave, and builds no walls) or balanced (it walls its town, and
// when it attacks it keeps a good part of its soldiers at home behind the wall and sends the rest). See
// "Winning and computer players" in docs/rules.md for what each level makes of it.
// look (optional): the shape its players' buildings take: standard (houses with walls and a roof, and walls
// and towers of their own materials) or mound (the Deepfolk: every hollow building is a mound of hive earth like
// an ant hill, as tall as the usual one and as hard to bring down, and walls, gates and towers are ramparts of
// hive earth). A building keeps the shape it was put up with when it is captured. Fields, bridges, lights and
// totems look the same for everyone. See "The Deepfolk" in docs/rules.md.
// replaces (optional): units and buildings the faction has its own in place of, as { "barracks": "brood_chamber" }.
// Its players cannot train or build the one named first, nor train anything in a replaced building (or its upgrade)
// they capture, and its matches start with the one named second instead; several may be replaced by the same one.
// A unit is replaced by a unit and a building by a building, of the faction or of everyone. See "The Deepfolk" in
// docs/rules.md.
[
  { "id": "settlers", "name": "Settlers", "uiLook": "stone", "description": "Humans who grow their units into new forms through experience.",
    "experience": { "levels": [150, 500], "perDamage": 1, "perKill": 10, "perBuildSecond": 1, "perMinute": 5 },
    "duskTree": "heal", "aiStyle": "balanced" },
  { "id": "orcs", "name": "Orcs", "uiLook": "timber", "description": "Clans who tame and ride the monsters they defeat.", "tamesMonsters": true,
    "duskTree": "raze", "aiStyle": "waves" },
  { "id": "deepfolk", "name": "Deepfolk", "uiLook": "crystal", "description": "An insect hive that hatches swarms in batches and burrows under walls unseen.", "look": "mound",
    "replaces": { "barracks": "brood_chamber", "spearman": "skitterling", "archer": "spitter", "rider": "skitterling",
      "sapper": "burrower", "mage": "spitter" },
    "duskTree": "raze", "aiStyle": "waves" },
  { "id": "elves", "name": "Elves", "uiLook": "timber", "description": "Forest guardians whose archers outrange everyone's, whose druids heal, and whose walls are living trees that grow back.",
    "replaces": { "spearman": "glade_warden", "archer": "elf_archer", "mage": "druid", "healer": "druid", "barrier": "living_wall" },
    "duskTree": "heal", "aiStyle": "balanced" },
  { "id": "dwarves", "name": "Dwarves", "uiLook": "stone", "description": "Iron-clad mountain clans who see in the dark, wall in stone and never forget a grudge.",
    "replaces": { "spearman": "ironshield", "rider": "ironshield", "archer": "crossbowman", "mage": "runesmith", "barrier": "stonework" },
    "duskTree": "raze", "aiStyle": "balanced" },
  { "id": "reptilians", "name": "Reptilians", "uiLook": "timber", "description": "The swamp brood: scaled warriors who regenerate, wade and hide in the water and flood the ground on purpose, but grow sluggish at night and in the hills.",
    "replaces": { "spearman": "scale_guard", "rider": "scale_guard", "archer": "blowpiper", "mage": "marsh_shaman" },
    "duskTree": "raze", "aiStyle": "waves" },
  { "id": "kage", "name": "Clan Kage", "uiLook": "crystal", "description": "Ratfolk ninja: scouts and assassins who vanish while they stand still, weaker in bright daylight.",
    "replaces": { "spearman": "kunoichi", "rider": "shinobi", "archer": "shuriken_thrower", "mage": "shadow_caster" },
    "duskTree": "raze", "aiStyle": "waves" }
]
