// City-states: towns of other races, too small to win the continent, that trade with everyone and are
// won by force. Every match has a town of each, as far from every start area as from the others.
//   totem: the building (of kind totem, see buildings.json) on the town's market. Whoever destroys it holds
//     the town; it stands again respawn seconds later, in the holder's colour, and whoever destroys that one
//     takes the town over.
//   guards: the units that stand round the market, one per entry. They belong to whoever holds the town
//     (the wild side while nobody does) and fight soldiers within reach columns of the town's square, but
//     never workers or caravans. A fallen guard is replaced every refill seconds.
//   tribute: while the town has a holder, a caravan (a unit with the trader role) brings them amount of
//     good every every seconds, to their first town hall.
//   trade: a caravan carries load of the good the town buys there from its owner's storage, and brings back
//     price of the good it sells for each 100 blocks between that storage and the town; the town's holder
//     gets holderBonus percent more.
//   mercenaries: the holder hires the units whose hiredFrom names the city-state (see units.json), paying
//     their cost, at most pool at a time; one more is ready every refill seconds.
//   heal (optional): the holder's hurt units within range columns of the town's square heal as at home
//     (the home rate in roles.json, wounds bound) once out of the fight. Leave it out for no healing there.
//   lair (optional): a monster (see "lair" in units.json) whose lair lies near the town.
//   wall, roof: what the town's huts are built of (planks, thatch, roof_tile or stone_brick).
// All the numbers are first guesses for playtesting.
[
  { "id": "goblins", "name": "Goblin town",
    "description": "Goblin traders and blades for hire. Break their totem and they bow to you: they send you tribute, guard their town against your enemies and sell you their blades.",
    "totem": { "building": "goblin_totem", "respawn": 5 },
    "guards": { "units": ["goblin_cutthroat", "goblin_cutthroat", "goblin_cutthroat", "goblin_slinger", "goblin_slinger", "goblin_slinger"], "reach": 4, "refill": 45 },
    "tribute": { "caravan": "caravan", "good": "iron", "amount": 15, "every": 60 },
    "trade": { "buys": "food", "load": 20, "sells": "iron", "price": 5, "holderBonus": 50 },
    "mercenaries": { "pool": 6, "refill": 30 },
    "heal": { "range": 6 },
    "lair": "wolf",
    "wall": "stone_brick", "roof": "thatch" },
  { "id": "ogres", "name": "Ogre hold",
    "description": "Huge, slow ogres who quarry the hills and fight for whoever beats them. Break their idol and they bow to you: they send you stone, guard their hold against your enemies and sell you brutes and boulder hurlers that heal even in a fight.",
    "totem": { "building": "ogre_idol", "respawn": 5 },
    "guards": { "units": ["ogre_brute", "ogre_brute", "ogre_hurler", "ogre_hurler"], "reach": 4, "refill": 60 },
    "tribute": { "caravan": "caravan", "good": "stone", "amount": 30, "every": 60 },
    "trade": { "buys": "food", "load": 20, "sells": "stone", "price": 10, "holderBonus": 50 },
    "mercenaries": { "pool": 3, "refill": 60 },
    "heal": { "range": 6 },
    "lair": "stone_giant",
    "wall": "stone_brick", "roof": "roof_tile" }
]
