// Techs, researched one at a time at the town hall. requires lists the techs that must come first;
// faction (optional) limits a tech to one faction. researchTime is in seconds, cost in goods. Units and
// buildings name the tech that unlocks them in their own "requires". icon (optional, the id if not
// given) names the picture the game shows for it (see game/scripts/UiIcons.cs). Research gives tools, not numbers:
// a tech opens a new ability, unit or building; the few stat buffs kept (housing, unit_hp) must be large, and the
// old small ones (gather_speed, carry, farm_yield, unit_speed) are refused. Effects:
//   housing       { building, amount or percent } each building of that type houses that many more, or that
//                                         percent more of its own number
//   unit_hp       { role or unit, fighters, amount or percent } more hit points, or that percent more of the
//                                         unit's own, for units already alive too; fighters: true keeps it to
//                                         units that fight (not workers, caravans, carts or transport ships)
//   roads                                 roads can be laid (if no tech has this, roads need no tech)
//   reveal        { what }                once researched, every ruin, lair or town (what: ruins, lairs or
//                                         towns) on the map shows through the fog as seen ground
//   spare_workers                         wild monsters leave the player's workers alone
//   shield_wall   { role or unit }        those units can take up a shield wall (numbers: shieldWall in roles.json)
//   felling       { role or unit, faction, time, crush }  those units (of that faction's players, if given) can fell a
//                                         tree the way they choose, in time seconds; it does crush damage to each unit and
//                                         building it comes down on, and lies across a gap of one or two as a log bridge
//   prospecting   { role or unit, faction, time, radius } those units can sound the ground, in time seconds: every ore,
//                                         coal, gold and crystal block within radius columns, at any depth, shows to the player
//   murder_holes                          stone gates drop stones on enemies at them while held (murderHoles in buildings.json)
//   molt          { role or unit }        those units can molt when badly hurt: heal to full standing still, then stay
//                                         soft a while (numbers: molt in roles.json)
//   salvage                               workers can take down the player's own finished buildings for half their cost back
//                                         and the goods they held (see "Salvage" in docs/rules.md)
//   field_repairs                         workers can mend the player's damaged catapults and battering rams in the field
//                                         for a share of their cost in materials (see "Field repairs" in docs/rules.md)
//   thorns                                the player's buildings with thorns (the Elves' living walls) prick whoever strikes
//                                         them from close up (see "thorns" in buildings.json)
//   cut_webs                              the player's units cut themselves out of webs: giant spiders' bites and the spider
//                                         silk's bearer no longer slow them (see "Monsters and taming" in docs/rules.md)
//   grudges       { percent }             an enemy unit that kills one of the player's units is marked with a grudge for life:
//                                         the player's units deal it that many percent more, and see it through the fog
//                                         (see "The Dwarves" in docs/rules.md)
//   bind_wounds   { after }               the player's units bind their own wounds: one out of the fight after seconds
//                                         (3 if not given) stops bleeding, grievous wounds too (see "Bleeding" in docs/rules.md)
// discovery (optional) makes it a discovery tech, researched only once the player has explored for it:
// ruin (their units searched an old ruin), lair (their unit got the last of a monster lair's pack), town
// (they broke a city-state's totem and took the town), giant (they beat a stone giant guarding a mountain
// pass), deeps (one of their units set foot in the deep caves) or crystal (one of their units dug crystal).
[
  { "id": "farming", "icon": "farm", "name": "Farming", "description": "Fields of grain.",
    "cost": { "wood": 40 }, "researchTime": 20 },
  { "id": "tools", "icon": "pick", "name": "Better tools", "description": "Iron axes and sounding rods. Militia can fell a tree the way you choose: onto enemies (heavy damage), onto a building, or across a gap or stream of one or two blocks as a log bridge. Foremen can sound the ground to show every ore, coal, gold and crystal block round them, however deep. Other factions' workers do both, but twice as slowly. Dwarf workers, born miners, sound the ground quicker than a foreman and further.",
    "cost": { "wood": 40, "stone": 20 }, "researchTime": 30,
    "effects": [
      { "type": "felling", "unit": "militia", "time": 4, "crush": 60 },
      { "type": "felling", "role": "worker", "faction": "orcs", "time": 8, "crush": 60 },
      { "type": "felling", "role": "worker", "faction": "deepfolk", "time": 8, "crush": 60 },
      { "type": "prospecting", "unit": "foreman", "time": 8, "radius": 12 },
      { "type": "prospecting", "unit": "master_builder", "time": 8, "radius": 12 },
      { "type": "prospecting", "role": "worker", "faction": "orcs", "time": 16, "radius": 12 },
      { "type": "prospecting", "role": "worker", "faction": "deepfolk", "time": 16, "radius": 12 },
      { "type": "prospecting", "role": "worker", "faction": "elves", "time": 16, "radius": 12 },
      { "type": "felling", "role": "worker", "faction": "elves", "time": 8, "crush": 60 },
      { "type": "felling", "role": "worker", "faction": "dwarves", "time": 8, "crush": 60 },
      { "type": "prospecting", "role": "worker", "faction": "dwarves", "time": 6, "radius": 16 } ] },
  { "id": "roads", "icon": "road", "name": "Roads", "description": "Packed gravel paths that double walking speed.",
    "cost": { "stone": 20 }, "researchTime": 20,
    "effects": [ { "type": "roads" } ] },
  { "id": "archery", "icon": "bow", "name": "Archery", "description": "Bows and the training to use them.",
    "cost": { "wood": 50 }, "researchTime": 30 },
  { "id": "basic_magic", "icon": "star", "name": "Basic magic", "description": "The first spells, taught at the barracks.",
    "cost": { "food": 60, "stone": 40 }, "researchTime": 40 },
  { "id": "masonry", "icon": "bricks", "name": "Masonry", "description": "Stone walls, gates and towers, and a mason's yard to cut stone. Stone gates get murder holes: while your units hold the walls beside a gate, stones drop on enemies at it.",
    "cost": { "stone": 60 }, "researchTime": 30, "requires": [ "tools" ],
    "effects": [ { "type": "murder_holes" } ] },
  { "id": "crop_rotation", "icon": "sprout", "name": "Crop rotation", "description": "Orchards: fruit trees that grow for a few minutes, then bear baskets of food with nobody working them, for workers and carts to carry in. Grown trees are too thick to see or shoot through, so an orchard screens a flank, and units push through it slowly. Raiders can cut it down, and it grows again from saplings.",
    "cost": { "food": 60, "wood": 30 }, "researchTime": 40, "requires": [ "farming" ] },
  { "id": "horse_breeding", "icon": "horse", "name": "Horse breeding", "description": "Mounts for riders.",
    "cost": { "food": 80, "wood": 40 }, "researchTime": 40, "requires": [ "farming" ] },
  { "id": "carts", "icon": "wheel", "name": "Handcarts", "description": "Pack ponies, trained at the town hall: quick, carrying little, they run the goods a building site still needs out from storage, bring workshops what they work, and carry what workshops, quarries and mines make back to storage, so builders keep building and workers keep working.",
    "cost": { "wood": 60 }, "researchTime": 30, "requires": [ "roads" ] },
  { "id": "smelting", "icon": "flame", "name": "Smelting", "description": "Furnaces that turn ore and coal into iron.",
    "cost": { "stone": 40, "wood": 20 }, "researchTime": 30, "requires": [ "masonry" ] },
  { "id": "sapping", "icon": "shovel", "name": "Sapping", "description": "Tunnellers who bring down walls.",
    "cost": { "wood": 40, "stone": 40 }, "researchTime": 30, "requires": [ "masonry" ] },
  { "id": "silk_knives", "icon": "silk_knife", "name": "Silk knives", "description": "Hooked knives on every belt, made for spider silk. Your units cut themselves out of a web the moment it lands: the forest's giant spiders and a bearer of the spider silk no longer slow them, so a nest can be fought, or run from.",
    "cost": { "wood": 30, "stone": 30 }, "researchTime": 30, "requires": [ "tools" ],
    "effects": [ { "type": "cut_webs" } ] },
  // Field medicine: wounds seen to in the field, away from home.
  { "id": "field_dressings", "icon": "bandage", "name": "Field dressings", "description": "Linen and the knack of binding a wound. Your units bind their own wounds: one that has gone 3 seconds without striking or being struck stops bleeding, a grievous wound too, wherever it is. Without it a wound only stops at home, from a healer, or when it clots, and a grievous one never clots.",
    "cost": { "food": 40, "wood": 20 }, "researchTime": 30, "requires": [ "farming" ],
    "effects": [ { "type": "bind_wounds", "after": 3 } ] },
  { "id": "field_hospital", "icon": "field_hospital", "name": "Field hospital", "description": "Build the field hospital, a hut for the wounded you can put up anywhere: by the front, at a siege camp, at a far mine. Your units within 12 columns of it heal as they do at home: 2% of their hit points a second once out of the fight, wounds bound, so a beaten army mends where it stands instead of walking home. It houses nobody, and the enemy can knock it down.",
    "cost": { "food": 50, "wood": 50 }, "researchTime": 40, "requires": [ "field_dressings" ] },
  { "id": "settler_guilds", "icon": "hammer", "name": "Craft guilds", "faction": "settlers", "description": "Masters teach the trades, taking down as well as putting up. Salvage: mark one of your finished buildings to take down, and workers (automatic ones too) take it apart in half the time it took to build, bringing back half its cost (less if it is damaged) and every good it held to your nearest other storage. Field repairs: right-click a damaged catapult or battering ram of yours with workers, and they mend it where it stands, even under fire, for a share of its cost in materials. Only the Settlers have these.",
    "cost": { "wood": 80, "stone": 40 }, "researchTime": 40, "requires": [ "tools" ],
    "effects": [ { "type": "salvage" }, { "type": "field_repairs" } ] },
  { "id": "settler_drill", "icon": "shield", "name": "Drilled ranks", "faction": "settlers", "description": "Line infantry can lock shields into a wall: it cannot move, but arrows and charges from the front do little. Weak from the sides unless the wall is a line.",
    "cost": { "food": 50, "iron": 5 }, "researchTime": 40, "requires": [ "smelting" ],
    "effects": [ { "type": "shield_wall", "role": "line_infantry" } ] },
  { "id": "orc_war_drums", "icon": "drum", "name": "War drums", "faction": "orcs", "description": "The barracks trains the war drummer. Broken orcs within earshot run to the drum instead of home and rally there. The drummer can beat the charge: for 6 seconds every orc in earshot runs 40% faster and its first blow lands half as hard again; then the drum needs a minute. While it drums, rivals within 40 columns see the drummer through the fog.",
    "cost": { "food": 60, "wood": 40 }, "researchTime": 40 },
  { "id": "orc_beast_pens", "icon": "paw", "name": "Beast pens", "faction": "orcs", "description": "Build the beast pen and keep up to 8 tamed wolves and boars in it. Drag a line from the pen and they burst out as a stampede: every beast that runs into an enemy deals it 30 and knocks it down, and they smash palisades and wooden buildings in their way (stone stops them). After the run they are tired and slow for 20 seconds.",
    "cost": { "food": 80, "wood": 40 }, "researchTime": 40, "requires": [ "horse_breeding" ] },
  { "id": "deep_chitin", "icon": "molt", "name": "Molting", "faction": "deepfolk", "description": "A badly hurt hive insect (a quarter of its life or less) can shed its shell: it stands still and heals back to full over 15 seconds, but while molting and for 30 seconds after it has no armour, takes half as much again from every hit and walks slower. One left idle out of the fight molts by itself. Pull a beaten swarm back, cover it, and send it in again.",
    "cost": { "food": 60, "wood": 40 }, "researchTime": 40,
    "effects": [ { "type": "molt", "role": "line_infantry" }, { "type": "molt", "role": "ranged" }, { "type": "molt", "role": "sapper" } ] },
  { "id": "deep_warrens", "icon": "brood_chamber", "name": "Brood warrens", "faction": "deepfolk", "description": "Deeper nests under every brood chamber: each houses twice as many.",
    "cost": { "food": 50, "wood": 50 }, "researchTime": 40, "requires": [ "farming" ],
    "effects": [ { "type": "housing", "building": "brood_chamber", "percent": 100 } ] },

  { "id": "elf_thornwood", "icon": "grow_forest", "name": "Thornwood", "faction": "elves", "description": "The druids sing thorns into the living walls: every blow struck at one from close up costs the striker 4 hit points. Arrows and siege engines are not hurt, but sappers and soldiers who hack at the hedge bleed for it.",
    "cost": { "wood": 60, "food": 40 }, "researchTime": 40,
    "effects": [ { "type": "thorns" } ] },

  { "id": "dwarf_grudges", "icon": "grudge", "name": "Book of Grudges", "faction": "dwarves", "description": "Every wrong is written down. An enemy that kills one of your units is marked with a grudge for the rest of its life, and your units deal it half as much damage again. A grudge is never forgotten: a marked enemy shows through the fog of war.",
    "cost": { "food": 40, "stone": 40 }, "researchTime": 40,
    "effects": [ { "type": "grudges", "percent": 50 } ] },

