  // The giant spiders: nests of three in the hill caves, a totem at the bottom of each. They spit webs so nobody can run, and their bites poison.
  { "id": "giant_spider", "name": "Giant spider", "role": "monster",
    "description": "A hairy spider as big as a pony, nesting in threes in the caves dug into the hills, round a silk-wrapped totem at the bottom. It spits a gob of web at whoever it fights from up to 8 blocks off, every 6 seconds: for 3 seconds they walk at less than half their pace, so whoever runs from a nest is run down. Its bite poisons, for 2 hit points a second over 6 seconds. Knock the totem down to clear the nest; whoever clears it takes up a skein of its silk.",
    "speed": 5.5, "hp": 70, "model": "giant_spider", "damage": 7, "attackTime": 1, "range": 1.25, "sight": 9,
    "attack": "pierce", "body": "beast", "armor": { "body": 1 }, "web": { "pace": 40, "time": 3, "range": 8, "every": 6 }, "poison": { "damage": 2, "time": 6 },
    "lair": { "pack": 3, "guard": 10, "leash": 16, "reward": { "food": 80, "wood": 40 }, "biome": "hills", "count": 2, "cave": true, "totem": "spider_totem",
      "prizes": { "orcs": { "relic": "spider_silk" }, "settlers": { "relic": "spider_silk" } } } },
  // Giant hornets swarm from a papery hive on a dead stump in the forests. Their stings frighten (each takes "fear"
  // morale), so a swarm sends a squad running; the hive hatches a new hornet every "grow" seconds while it stands, so the
  // nest is cleared by knocking the hive down, not by swatting hornets. First guesses for playtesting.
  { "id": "giant_hornet", "name": "Giant hornet", "role": "monster",
    "description": "A hornet as long as a forearm, black and amber, swarming from a papery hive on a dead stump in the forests. Its sting is light but terrifying: each that lands takes 6 morale, so a swarm breaks a squad and sends it running long before it has killed many. A hero near them steadies them. The hive hatches a new hornet every 20 seconds while it stands, back to a swarm of five, even once the swarm is dead: knock the hive down to clear the nest, and whoever does takes up the queen's sting.",
    "speed": 7, "hp": 30, "model": "giant_hornet", "damage": 4, "attackTime": 0.8, "range": 1.25, "sight": 10,
    "attack": "pierce", "body": "beast", "fear": 6,
    "lair": { "pack": 5, "guard": 10, "leash": 18, "reward": { "food": 120, "wood": 30 }, "biome": "forest", "count": 2, "totem": "hornet_hive",
      "grow": 20, "growTo": 5,
      "prizes": { "orcs": { "relic": "queens_sting" }, "settlers": { "relic": "queens_sting" } } } },

