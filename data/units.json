  { "id": "bombard_ship", "name": "Bombard ship", "role": "siege", "sails": true, "speed": 2.5, "hp": 240, "model": "bombard_ship",
    "description": "A broad-beamed ship with an iron bombard on its deck, built at a dock. Sails the rivers, lakes and sea and lobs its shells over walls at towns on the shore from the water, blowing craters where its shells land, but cannot hit anything closer than 4 blocks. Slow, and siege hits it twice as hard: catapults on the shore and other bombard ships are its bane. Bridges and ice stop it.",
    "damage": 35, "attackTime": 6, "range": 16, "minRange": 4, "sight": 13, "splash": 1.5,
    "blast": true, "crater": 2, "lobs": true, "machine": true, "attack": "crush", "armor": { "head": 2, "torso": 2, "arms": 2, "legs": 2 },
    "weakTo": { "siege": 100 },
