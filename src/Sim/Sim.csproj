<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Rts.Sim</RootNamespace>
    <AssemblyName>Rts.Sim</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- The game's data, built into the core so every build, test and tool plays with the same content. -->
    <EmbeddedResource Include="../../data/*.json" LogicalName="data/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
